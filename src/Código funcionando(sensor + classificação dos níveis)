import random
import time
from datetime import datetime

# Nível do rio em metros (valores simulados)
NIVEL_MINIMO = 0.5
NIVEL_MAXIMO = 8.0
INTERVALO_SEGUNDOS = 5

# Limites em metros (valores de exemplo; ajustar com dados reais)
LIMITE_ATENCAO = 3.0
LIMITE_ALERTA = 5.0
LIMITE_EMERGENCIA = 7.0


def ler_nivel():
    """Simula a leitura do sensor e devolve o nível do rio em metros."""
    return round(random.uniform(NIVEL_MINIMO, NIVEL_MAXIMO), 2)


def classificar_nivel(nivel):
    """Recebe o nível do rio em metros e devolve a situação de risco."""
    if nivel >= LIMITE_EMERGENCIA:
        return "EMERGÊNCIA"
    if nivel >= LIMITE_ALERTA:
        return "ALERTA"
    if nivel >= LIMITE_ATENCAO:
        return "ATENÇÃO"
    return "NORMAL"


def main():
    print("Sensor simulado do Rio Una (Ctrl+C para parar)")
    try:
        while True:
            nivel = ler_nivel()
            hora = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
            situacao = classificar_nivel(nivel)
            print(f"[{hora}] Nível do rio: {nivel:.2f} m - {situacao}")
            time.sleep(INTERVALO_SEGUNDOS)
    except KeyboardInterrupt:
        print("\nMonitoramento encerrado.")


if __name__ == "__main__":
    main()
